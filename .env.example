# ══════════════════════════════════════════════════════════
# Servidor local (PC do totem no evento)
# ══════════════════════════════════════════════════════════

PORT=3000
HTTPS_PORT=3443
# O celular só libera a câmera em contexto seguro. Deixe ativado.
ENABLE_HTTPS=true

# ══════════════════════════════════════════════════════════
# Vercel
#
# VERCEL, REDIS_URL e BLOB_READ_WRITE_TOKEN são preenchidas pela
# própria plataforma quando você conecta o Redis e o Blob ao projeto.
# Nada aqui precisa ser copiado à mão num deploy normal.
#
# Para simular o modo Vercel localmente:
#   STATE_DRIVER=redis
#   STORAGE_DRIVER=blob
#   REDIS_URL=redis://...
#   BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# ══════════════════════════════════════════════════════════

# memory (padrão local) | redis (obrigatório na Vercel)
# STATE_DRIVER=memory
# local (padrão) | blob (padrão na Vercel)
# STORAGE_DRIVER=local

# ══════════════════════════════════════════════════════════
# Conexão do preview (WebRTC)
#
# O STUN só descobre o endereço público. Quando não existe rota direta
# entre celular e totem — celular no 4G, ou Wi-Fi de convidado com
# isolamento de cliente — quem fecha a conexão é um TURN.
#
# Sem TURN o app não quebra: o preview cai para frames JPEG relayados
# pelo servidor (mais latência, menos fluidez, funciona em qualquer
# rede). A FOTO nunca depende disso: sobe por HTTPS em resolução máxima.
#
# Provedores com plano gratuito: Cloudflare Realtime TURN, Metered,
# Twilio. Cole as URLs separadas por vírgula.
# ══════════════════════════════════════════════════════════

# TURN_URLS=turn:seu-turn:3478?transport=udp,turns:seu-turn:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ── Preview relayado (plano B, usado quando o WebRTC não fecha) ──
# Largura dos frames em px; o resto acompanha a proporção.
RELAY_WIDTH=640
# Quadros por segundo. Cada ponto a mais é banda no servidor.
RELAY_FPS=8
# Qualidade JPEG dos frames (20–90).
RELAY_QUALITY=50
# Quanto esperar o WebRTC antes de assumir que não vai fechar (ms).
RELAY_FALLBACK_MS=8000

# ══════════════════════════════════════════════════════════
# Qualidade da foto final
# ══════════════════════════════════════════════════════════

# Qualidade JPEG do arquivo master (1–100). 100 = máximo.
FINAL_JPEG_QUALITY=100
# Teto do lado maior do master, em pixels. 0 = sem teto (resolução do sensor).
MAX_FINAL_LONG_SIDE=0
# Derivada leve servida na página do QR (o convidado abre no 4G).
WEB_LONG_SIDE=2048
WEB_JPEG_QUALITY=88

# ══════════════════════════════════════════════════════════
# Armazenamento
# ══════════════════════════════════════════════════════════

# Guarda o JPEG cru do celular, com EXIF
SAVE_ORIGINAL=true
# Copia o master para a pasta Downloads (ignorado na Vercel)
SAVE_TO_DOWNLOADS=true
# DOWNLOADS_DIR=C:\Fotos\Evento

# ══════════════════════════════════════════════════════════
# Limites
# ══════════════════════════════════════════════════════════

# Só vale no modo local: na Vercel a foto sobe direto para o Blob,
# porque o corpo de uma request de função para em 4,5 MB.
MAX_UPLOAD_MB=60
SHARP_CONCURRENCY=2
SESSION_TTL_HOURS=24
